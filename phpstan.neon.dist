includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max

    ignoreErrors:
            -
                message: '#Trait Oliwol\\Slugify\\HasSlug is used zero times and is not analysed.#'
                path: src/HasSlug.php
            -
                message: '#Trait Oliwol\\Slugify\\HasSlugHistory is used zero times and is not analysed.#'
                path: src/HasSlugHistory.php
            -
                message: '#Trait Oliwol\\Slugify\\HasTranslatableSlug is used zero times and is not analysed.#'
                path: src/HasTranslatableSlug.php

    paths:
        - src